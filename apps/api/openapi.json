{
  "openapi": "3.0.3",
  "info": {
    "title": "A API do projeto",
    "description": "Toda rota aparece aqui, com o que recebe e o que devolve.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/saude": {
      "get": {
        "summary": "Confere se a API está no ar",
        "tags": [
          "sistema"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "hora": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "hora"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/negocio": {
      "get": {
        "summary": "Os dados públicos do negócio: nome, horários, produtos disponíveis e se está aberto agora",
        "tags": [
          "negócio"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nome": {
                      "type": "string",
                      "minLength": 1
                    },
                    "frase": {
                      "type": "string"
                    },
                    "telefone": {
                      "type": "string",
                      "pattern": "^55\\d{10,11}$"
                    },
                    "temWhatsapp": {
                      "type": "boolean"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    },
                    "endereco": {
                      "type": "string"
                    },
                    "horarios": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "dia": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 6
                          },
                          "abre": {
                            "type": "string",
                            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                          },
                          "fecha": {
                            "type": "string",
                            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                          }
                        },
                        "required": [
                          "dia",
                          "abre",
                          "fecha"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "produtos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "nome": {
                            "type": "string",
                            "minLength": 1
                          },
                          "descricao": {
                            "type": "string"
                          },
                          "precoCentavos": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "foto": {
                            "nullable": true,
                            "type": "string",
                            "pattern": "^\\/fotos(\\/[A-Za-z0-9][\\w.-]*)+$"
                          },
                          "disponivel": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "nome",
                          "descricao",
                          "precoCentavos",
                          "foto",
                          "disponivel"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "redes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nome": {
                            "type": "string",
                            "minLength": 1
                          },
                          "endereco": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "nome",
                          "endereco"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "abertoAgora": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "nome",
                    "frase",
                    "telefone",
                    "temWhatsapp",
                    "endereco",
                    "horarios",
                    "produtos",
                    "redes",
                    "abertoAgora"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
