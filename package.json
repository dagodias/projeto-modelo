{
  "name": "projeto-modelo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && node --test infra/*.test.mjs",
    "e2e": "pnpm build && playwright test",
    "contrato": "pnpm --filter @projeto/api openapi && pnpm --filter @projeto/web tipos:api",
    "typecheck": "pnpm contrato && pnpm -r run typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "segredos": "secretlint \"**/*\"",
    "publicar": "node infra/publicar.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@projeto/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "secretlint": "^14.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
